# Copy to deploy/.env (or .env next to docker-compose.yml on a server). Never commit the real file.

# Strong random password, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# The URL people use in their browser and with `relay login --server ...`
PUBLIC_URL=https://relay.example.com

# HTTPS: the domain Caddy gets a certificate for. Its DNS must point at this server.
DOMAIN=relay.example.com

# "tls" runs Caddy on ports 80/443. Leave empty if you already run nginx or another
# proxy; point it at 127.0.0.1:SERVER_PORT instead.
COMPOSE_PROFILES=tls

# Port the API listens on. It binds to 127.0.0.1 only; set SERVER_BIND=0.0.0.0
# to expose it directly (not recommended without TLS).
SERVER_PORT=8787
# SERVER_BIND=127.0.0.1

# Where full transcripts are kept: local (a Docker volume)
STORAGE_DRIVER=local

# Copy to .env (next to docker-compose.yml on the server, or deploy/.env locally). Never commit the real file.

# Strong random password, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Public URL people use with `relay login --server ...`
PUBLIC_URL=https://relay.example.com

# Domain Caddy gets an HTTPS certificate for (production compose only)
DOMAIN=relay.example.com

# "tls" runs Caddy on ports 80/443. Leave empty if the server already has nginx or another proxy.
COMPOSE_PROFILES=tls

# Host port the API listens on (127.0.0.1 only in production)
SERVER_PORT=8787

# Where full transcripts are kept: local (Docker volume)
STORAGE_DRIVER=local

# Copy to deploy/.env and fill in. Never commit the real file.

# Strong random password, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=

# Public URL people will use with `relay login --server ...`
PUBLIC_URL=https://relay.example.com

# Host port the API listens on (put a reverse proxy with TLS in front of it)
SERVER_PORT=8787

# Where full transcripts are kept: local (Docker volume) or s3 (later)
STORAGE_DRIVER=local

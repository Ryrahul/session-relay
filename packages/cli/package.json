{
  "name": "session-relay",
  "version": "0.5.1",
  "mcpName": "io.github.Ryrahul/session-relay",
  "description": "Share coding-agent sessions (Claude Code, Codex, OpenCode, Gemini CLI, Copilot CLI, Cursor, ZCode) with your team. /share in one agent, /pickup in another. Handoffs for teammates, PR links, edits.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "claude-code",
    "opencode",
    "codex",
    "zcode",
    "gemini-cli",
    "copilot-cli",
    "cursor",
    "mcp",
    "ai-agents",
    "handoff",
    "sessions",
    "cli"
  ],
  "homepage": "https://relay.rahulweb.online/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ryrahul/session-relay.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Ryrahul/session-relay/issues"
  },
  "type": "module",
  "bin": {
    "relay": "dist/relay.js",
    "session-relay": "dist/relay.js"
  },
  "files": [
    "dist/relay.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "@session-relay/shared": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
